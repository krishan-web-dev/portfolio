# Public configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Supabase service credentials (never use NEXT_PUBLIC_ prefixes)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PRIVATE_BUCKET=portfolio-private

# Cloudflare Turnstile server secret
TURNSTILE_SECRET_KEY=

# Brevo SMTP (use the SMTP login and SMTP key, not an API key or account password)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
PORTFOLIO_OWNER_EMAIL=krishanthananayakkara@gmail.com
PORTFOLIO_FROM_EMAIL=krishanthananayakkara@gmail.com

# Set to true to restore the private case-study access gate
PORTFOLIO_PRIVACY_ENABLED=false

# Generate two different high-entropy values, at least 32 random bytes each
PORTFOLIO_OWNER_PASSPHRASE=
PORTFOLIO_TOKEN_PEPPER=
