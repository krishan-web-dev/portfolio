# Public configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Supabase service credentials (never use NEXT_PUBLIC_ prefixes)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PRIVATE_BUCKET=portfolio-private

# Cloudflare Turnstile server secret
TURNSTILE_SECRET_KEY=

# Resend (use a verified production sending domain)
RESEND_API_KEY=
PORTFOLIO_OWNER_EMAIL=
PORTFOLIO_FROM_EMAIL=Portfolio <portfolio@your-verified-domain.example>

# Generate two different high-entropy values, at least 32 random bytes each
PORTFOLIO_OWNER_PASSPHRASE=
PORTFOLIO_TOKEN_PEPPER=
